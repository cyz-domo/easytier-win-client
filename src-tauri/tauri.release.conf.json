{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "core-stage/*": "core/",
      "service-stage/easytier-service.exe": "easytier-service.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "useLocalToolsDir": true
  }
}